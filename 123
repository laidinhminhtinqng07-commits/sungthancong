    const QUESTIONS_PER_ROUND = 5;
    let currentQuestions = [];
    let score = 0;
    let answeredCount = 0;

    function getRandomQuestions(sourceArray, count) {
      const shuffled = [...sourceArray];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled.slice(0, count);
    }

    function showFinalResult() {
      const resultBox = document.getElementById("result-box");
      resultBox.style.display = "block";

      if (score === currentQuestions.length) {
        const randomCode = Math.floor(1000 + Math.random() * 9000);
        resultBox.className = "result-box success";
        resultBox.innerHTML = `
          <div class="result-title">🎉 Chúc mừng! Bạn đã đạt điểm tuyệt đối (${score}/${currentQuestions.length})</div>
          <div class="result-desc">Mã xác nhận 4 chữ số của bạn là:</div>
          <div class="secret-code">${randomCode}</div>
        `;
      } else {
        resultBox.className = "result-box retry";
        resultBox.innerHTML = `
          <div class="result-title">Bạn đạt ${score}/${currentQuestions.length} điểm</div>
          <div class="result-desc" style="margin-bottom:0;">Hãy trả lời đúng toàn bộ ${currentQuestions.length} câu hỏi để nhận dãy số ngẫu nhiên 4 chữ số nhé!</div>
        `;
      }
    }

    function initQuiz() {
      score = 0;
      answeredCount = 0;
      currentQuestions = getRandomQuestions(quizData, QUESTIONS_PER_ROUND);

      document.getElementById("score").innerText = score;
      document.getElementById("total").innerText = currentQuestions.length;

      const resultBox = document.getElementById("result-box");
      resultBox.style.display = "none";
      resultBox.innerHTML = "";

      const container = document.getElementById("quiz-container");
      container.innerHTML = "";

      currentQuestions.forEach((item, index) => {
        const card = document.createElement("div");
        card.className = "question-card";

        const qTitle = document.createElement("div");
        qTitle.className = "question-text";
        qTitle.innerText = `Câu ${index + 1}: ${item.question}`;
        card.appendChild(qTitle);

        const optionsDiv = document.createElement("div");
        optionsDiv.className = "options-list";

        const feedback = document.createElement("div");
        feedback.className = "feedback-text";

        item.options.forEach((optText, oIndex) => {
          const btn = document.createElement("button");
          btn.className = "option-btn";
          btn.innerText = optText;
          btn.onclick = () => {
            const allBtns = optionsDiv.querySelectorAll(".option-btn");
            allBtns.forEach(b => b.disabled = true);
            answeredCount++;

            if (oIndex === item.correct) {
              btn.classList.add("correct");
              score++;
              document.getElementById("score").innerText = score;
              feedback.style.color = "#81c995";
              feedback.style.borderLeft = "3px solid #34a853";
              feedback.innerText = "✓ Chính xác! " + item.explanation;
            } else {
              btn.classList.add("wrong");
              allBtns[item.correct].classList.add("correct");
              feedback.style.color = "#f28b82";
              feedback.style.borderLeft = "3px solid #ea4335";
              feedback.innerText = "✗ Chưa chính xác! Đáp án đúng là \"" + item.options[item.correct] + "\". " + item.explanation;
            }
            feedback.style.display = "block";

            if (answeredCount === currentQuestions.length) {
              showFinalResult();
            }
          };
          optionsDiv.appendChild(btn);
        });

        card.appendChild(optionsDiv);
        card.appendChild(feedback);
        container.appendChild(card);
      });
    }

    initQuiz();
  </script>

